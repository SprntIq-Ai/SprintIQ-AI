PROJECT_NAME="SprintIQ AI"
ENVIRONMENT="development"
SECRET_KEY="sprintiq-ai-super-secret-jwt-key-enterprise-grade-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase / PostgreSQL Database URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./sprintiq.db"

# Supabase Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="sprintiq-attachments"

# Google Gemini API
GEMINI_API_KEY=""

# GitHub live data (30s polling). Recommended for reliable performance.
# Create a fine-grained token (Repository access, read-only "Contents" + "Metadata")
# at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=""

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://sprintiq-ai.vercel.app"]

# Google OAuth (server-side only). Never expose GOOGLE_CLIENT_SECRET to the frontend.
# Create an OAuth 2.0 Client ID (Web app) at https://console.cloud.google.com/apis/credentials
# and add exactly the resolved redirect URI to the authorized redirect URIs.
# FRONTEND_URL = public SPA origin (production: e.g. https://sprintiq-ai.vercel.app)
# GOOGLE_REDIRECT_URI defaults to {FRONTEND_URL}/auth/google/callback; set it explicitly
# to override (e.g. when the callback lives on a different host).
FRONTEND_URL="http://localhost:5173"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/auth/google/callback"
